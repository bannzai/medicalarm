rules_version = '2';

// 設計方針:
// JWT (Firebase Auth) の本人認証 + リソース所有 (グループメンバー) 判定を基本とし、
// グループ配下でも本人性が要る書き込み (自分の userProfile / memberNotificationSettings) は対象ユーザー本人に限定する。
// 一方でデータ内容に踏み込んだガード (プレミアム判定・期間判定・フィールド diff 等) は実装しない。
//
// /users ツリーは medicalarm-prod にデプロイ済みだった旧ルール (#242 でエクスポート) の
// 操作別許可 (privates は read 不可・users は delete 不可・doseReceivers は delete 不可) を維持し、
// グループ機能 (#241) で以下を追加している:
// - /groups ツリーと /groupInvitations
// - デバッグユーザーパターン ({uid}_debug_N)
// - /users/{userID}/diaries (旧ルールに match が無く deny だったが、グループ移行が読み取るため追加)
// - users の create を本人 + デバッグユーザーに限定 (旧ルールは認証済みなら他人の uid でも作成可能だった)
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isUserAuth(id) {
      return isAuth() && request.auth.uid == id;
    }

    // デバッグユーザーID ({uid}_debug_1 等) を実ユーザーが操作できるかチェック。
    // 1 台の Simulator での複数ユーザー E2E 用 (shoppinglist 踏襲)。
    function isDebugUserOf(userDocID) {
      return isAuth() && userDocID.matches(request.auth.uid + '_debug_[0-9]+');
    }

    function isMember(memberUserIDs) {
      return isAuth() && request.auth.uid in memberUserIDs;
    }

    match /users/{userID} {
      allow read, create, update: if isUserAuth(userID) || isDebugUserOf(userID);

      // fcmToken / fcmTokens / apnsToken。旧ルールどおり read は許可しない (クライアントは書き込みのみ)。
      match /privates/{privateID} {
        allow create, update: if isUserAuth(userID) || isDebugUserOf(userID);
      }

      // グループ移行後も /users/{userID} 配下に残置するレガシーデータ。
      match /medicines/{medicineID} {
        allow read, create, update, delete: if isUserAuth(userID) || isDebugUserOf(userID);
      }

      match /medicationHistories/{medicationHistoryID} {
        allow read, create, update, delete: if isUserAuth(userID) || isDebugUserOf(userID);
      }

      // 旧ルールどおり delete は許可しない (DoseReceiver は削除不可の設計)。
      match /doseReceivers/{doseReceiverID} {
        allow read, create, update: if isUserAuth(userID) || isDebugUserOf(userID);
      }

      // 旧ルールに match が無く deny だったが、グループ移行 (GroupMigration) が読み取るため追加。
      match /diaries/{diaryID} {
        allow read, create, update, delete: if isUserAuth(userID) || isDebugUserOf(userID);
      }
    }

    // グループ招待: クライアントから直接 read/write しない
    // (createGroupInvitation / acceptGroupInvitation Function の Admin SDK 経由のみ)。
    match /groupInvitations/{invitationID} {
      allow read, write: if false;
    }

    match /groups/{groupID} {
      // グループ削除フローはクライアントに無いため delete は許可しない。update はグループ名編集で使う。
      allow read, update: if isMember(resource.data.memberUserIDs);
      // グループ作成は createGroup Function 経由でのみ許可する。
      allow create: if false;

      function isGroupMember() {
        return isMember(get(/databases/$(database)/documents/groups/$(groupID)).data.memberUserIDs);
      }

      // read はメンバー全員。書き込みは自分の profile のみ (displayName 編集は本人だけが行う)。
      match /userProfiles/{profileID} {
        allow read: if isGroupMember();
        allow create: if isGroupMember() && (isUserAuth(request.resource.data.userID) || isDebugUserOf(request.resource.data.userID));
        allow update, delete: if isGroupMember() && (isUserAuth(resource.data.userID) || isDebugUserOf(resource.data.userID));
      }

      match /medicines/{medicineID} {
        allow read, write: if isGroupMember();
      }

      // DoseReceiver は削除不可の設計をグループ側でも維持するため delete を許可しない。
      match /doseReceivers/{doseReceiverID} {
        allow read, create, update: if isGroupMember();
      }

      match /medicationHistories/{historyID} {
        allow read, write: if isGroupMember();
      }

      match /diaries/{diaryID} {
        allow read, write: if isGroupMember();
      }

      // メンバー個別通知設定。docID = memberUserID。read はメンバー全員だが、
      // write は本人のみ (端末個人設定を他メンバーに書き換えられないようにする)。
      match /memberNotificationSettings/{memberUserID} {
        allow read: if isGroupMember();
        allow write: if isGroupMember() && (isUserAuth(memberUserID) || isDebugUserOf(memberUserID));
      }
    }
  }
}
