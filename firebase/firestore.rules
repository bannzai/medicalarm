rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }
    match /users/{userId}/privates/{privateId} {
      allow create, update: if request.auth.uid == userId;
    }
    match /users/{userId}/medicines/{medicineId} {
      allow read, create, update, delete: if request.auth.uid == userId;
    }
    match /users/{userId}/medicationHistories/{medicationHistoryId} {
      allow read, create, update, delete: if request.auth.uid == userId;
    }
    match /users/{userId}/doseReceivers/{doseReceiverId} {
      allow read, create, update: if request.auth.uid == userId;
    }
  }
}
