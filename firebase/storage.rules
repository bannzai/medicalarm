rules_version = '2';

// 薬メモ画像 (lib/utils/storage/firebase_cloud_storage.dart の uploadImage が保存)。
// /users パスは medicalarm-prod にデプロイ済みだった旧ルール (#242 でエクスポート) と同じ本人限定。
// /groups パスはグループ機能 (#241) で追加。表示は download URL (トークン付き) 経由のため
// ルール評価を通らず、SDK read はアップロード直後の本人 (=メンバー) のみが行う。
service firebase.storage {
  match /b/{bucket}/o {
    // 既存パス: 本人がアップロードした薬メモ画像。本人のみ read/write。
    match /users/{userID}/medicines/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userID;
    }

    // 新規パス: グループ共有の薬メモ画像。Firestore の group ドキュメントを
    // クロスサービス参照し、memberUserIDs に含まれるメンバーのみ read/write。
    match /groups/{groupID}/medicines/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupID)).data.memberUserIDs;
    }
  }
}
